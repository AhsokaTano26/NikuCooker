# pnpm settings for the web application.
#
# Written down rather than left to pnpm's defaults because a default can change
# between releases, and the Docker image, CI and a developer machine each
# resolve pnpm independently. An implicit policy is how "it builds locally"
# becomes a mystery.

# Reject packages published less than this many minutes ago. This is a real
# supply-chain control: it is the window in which a compromised release gets
# caught by the community before it reaches this project.
#
# 0 today, deliberately, not by oversight. The toolchain was pinned the day the
# project started, so every dependency is newer than any useful threshold.
# Raise this — 1440 is the usual choice — once the dependency set stops moving,
# and before any release that ships to users.
minimumReleaseAge=0
